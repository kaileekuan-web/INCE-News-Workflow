# API Keys and Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API (for summarization - optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (FREE - for article summarization)
# Get your free API key at: https://ai.google.dev/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (for Gmail/Sheets/Slides)
# Note: credentials.json and token.json are separate OAuth files

# NewsAPI.org (for TechCrunch)
NEWSAPI_ORG_KEY=f7191e1a9d5b467abd7b67178eaca96b

# Z Potentials Substack URL
Z_POTENTIALS_URL=https://zpotentials.substack.com

# Local Ollama (FREE, no API key) — used for all summarization, translation, and
# funding extraction. Install: https://ollama.com  Then: ollama pull qwen2.5:32b-instruct-q4_K_M
# Both are optional — these are the defaults if unset.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:32b-instruct-q4_K_M

# X/Twitter collection (FREE, no API key) — comma-separated Nitter instances,
# only needed if the built-in defaults in collect_x.py are down.
# NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org

# Add other API keys as needed
# SERPER_API_KEY=your_serper_key_here
