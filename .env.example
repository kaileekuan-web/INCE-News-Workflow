# API Keys and Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API — required. Every inference in the pipeline (summarization,
# categorization, funding extraction, translation, insights, debate agents)
# goes through Claude on this one key.
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Claude overrides — see tools/utils.py for what each one does.
# NEWS_-prefixed on purpose: a bare CLAUDE_MODEL/CLAUDE_EFFORT is already set
# inside a Claude Code shell, and an unprefixed name would let the pipeline
# silently inherit it when run from there.
# NEWS_CLAUDE_MODEL=claude-opus-5
# NEWS_CLAUDE_EFFORT=low
# NEWS_CLAUDE_MAX_TOKENS=4096

# Google OAuth (for Gmail/Sheets/Slides)
# Note: credentials.json and token.json are separate OAuth files

# NewsAPI.org (for TechCrunch)
NEWSAPI_ORG_KEY=f7191e1a9d5b467abd7b67178eaca96b

# Z Potentials Substack URL
Z_POTENTIALS_URL=https://zpotentials.substack.com

# X/Twitter collection (FREE, no API key) — comma-separated Nitter instances,
# only needed if the built-in defaults in collect_x.py are down.
# NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org

# Add other API keys as needed
# SERPER_API_KEY=your_serper_key_here
